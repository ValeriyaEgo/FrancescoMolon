        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "position": "sticky",
              "top": "40px",
              "@media (max-width: 992px)": {
                "position": "static",
                "margin-bottom": "40px"
              },
              ".mbr-label": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".panel-group": {
              ".card": {
                "position": "relative",
                "padding": "8px",
                "background-color": "@cardBg_1",
                "border": "none",
                "margin-top": "16px",
                "&:first-child": {
                  "margin-top": "0"
                },
                "@media (max-width: 992px)": {
                  "margin-top": "20px",
                  "&:first-child": {
                    "margin-top": "0"
                  }
                },
                ".card-header": {
                  "background-color": "transparent",
                  "border": "none",
                  "border-radius": "0",
                  "padding": "0",
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "width": "100%",
                    "padding": "16px",
                    "@media (max-width: 992px)": {
                      "padding": "20px"
                    },
                    ".panel-title-edit": {
                      "margin-bottom": "0",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".icon-wrapper": {
                      "width": "22px",
                      "height": "22px",
                      "min-width": "22px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "margin-left": "12px",
                      "transition": "all 0.3s ease-in-out",
                      "border": "1px solid @icon",
                      "border-radius": "100%",
                      ".mbr-iconfont": {
                        "font-size": "12px",
                        "margin-top": "2px",
                        "transition": "all 0.3s ease-in-out",
                        "color": "@icon"
                      }
                    },
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        "transform": "rotate(-180deg)"
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "margin-top": "8px",
                    "padding": "24px",
                    "background-color": "@cardBg_2",
                    "@media (max-width: 992px)": {
                      "padding": "20px"
                    },
                    ".panel-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label": {
              "color": "#800020"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#6c7179"
            },
            ".panel-title-edit": {
              "color": "#000000"
            },
            ".panel-text": {
              "color": "#6c7179"
            }
          },
          "_name": "list01",
          "_sourceTheme": "standm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 standm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Cards</header>\n        <input type=\"color\" title=\"Icon Color\" value=\"#6c7179\" name=\"icon\" selected>\n        <input type=\"color\" title=\"BG 1\" value=\"#ffffff\" name=\"cardBg_1\" selected>\n        <input type=\"color\" title=\"BG 2\" value=\"#f7f7f7\" name=\"cardBg_2\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-5\">\n                            <div class=\"title-wrapper\">\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\"><b>\n                                    ЧАСТО ЗАДАВАЕМЫЕ ВОПРОСЫ</b></p>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Что важно знать о сотрудничестве с Франческо Молон?</h2>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        Ниже мы собрали ответы на самые популярные вопросы о каталогах, образцах, моделях и условиях сотрудничества.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\">\n                            <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                                <div class=\"card little-radius\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Как получить полный каталог, прайс-листы и условия сотрудничества?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                Заполните форму регистрации на нашем сайте, и мы направим вам ссылку для скачивания актуальных каталогов, фабричных прайс-листов и условий партнёрства.</p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"card little-radius\" mbr-if=\"cardAmount > 1\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Как получить 3D-модели конкретных изделий?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                После регистрации на сайте вы получите доступ к 3D-моделям выбранных продуктов. Наши материалы подготовлены для удобной интеграции в профессиональные дизайн-проекты.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"card little-radius\" mbr-if=\"cardAmount > 2\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Можно ли заказать образцы отделок для проекта?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                Да, мы предоставляем образцы шпона, тканей, покрытий и финишей. После запроса наш представитель свяжется с вами для уточнения деталей и организации доставки образцов.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"card little-radius\" mbr-if=\"cardAmount > 3\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Возможно ли организовать презентацию или встречу с представителем фабрики?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                Да, мы проводим персональные встречи, презентации коллекций и частные показы для архитекторов и дизайнеров. Формат мероприятия обсуждается индивидуально с учётом ваших задач и аудитории.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"card little-radius\" mbr-if=\"cardAmount > 4\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Предоставляет ли фабрика поддержку при реализации проектов?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                Francesco Molon сопровождает проекты на всех этапах - от подбора моделей и адаптации размеров до согласования индивидуальных решений и технических спецификаций.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"card little-radius\" mbr-if=\"cardAmount > 5\">\n                                    <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                            <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">Осуществляется ли доставка и монтаж мебели?</h4>\n                                            <div class=\"icon-wrapper\">\n                                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                            </div>\n                                        </a>\n                                    </div>\n                                    <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                        <div class=\"panel-body lit-radius\">\n                                            <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                                Да, мы организуем полный цикл поставки: логистику, таможенное оформление (при необходимости) и профессиональную установку мебели на объекте.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v3gt1GqT8p",
          "_anchor": "list01-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer02",
          "_sourceTheme": "laborm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"2\" max=\"4\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/laborm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2b0a12\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/laborm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        condition=\"overlay &amp;&amp; bg.type === 'video'\"&gt;\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#272727\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div mbr-class=\"{'container': !fullWidth}\" video-to-image-on-mobile=\"{{videoToImageOnMobile}}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-sm-4 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <a href=\"https://www.francescomolon.com/\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/photo-2026-03-302015.43.07-300x223.webp\" alt=\"Франческо Молон\"></a>\n\n                </div>\n            </div>\n            <div class=\"col-lg col-sm-8\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title align-left mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Официальный представитель Франческо Молон и Aina Kari в России.</b></h3>\n                    <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Непревзойдённая мебель и аксессуары ручной работы из Венеции: от изысканной классики в стиле ампира до современных дизайнерских коллекций. Роскошные предметы интерьера, в которых итальянские традиции сочетаются с актуальной эстетикой и безупречным мастерством.<br><br>© Франческо Молон 2026 - Все права защищены<br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@fullWidth)": {
              ".text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".text-wrapper": {
              "padding": "2rem 1rem"
            },
            "img": {
              "width": "80%",
              "padding": "2rem 0",
              "margin": "auto"
            },
            "@media (min-width: 992px)": {
              ".text-wrapper": {
                "padding": "2rem"
              }
            },
            ".mbr-text": {
              "color": "#bbbbbb"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".row": {
              "border-top": "2px solid rgba(255, 255, 255, 0.15)",
              "border-bottom": "2px solid rgba(255, 255, 255, 0.15)"
            }
          },
          "_cid": "ve20GlghKr",
          "_anchor": "footer02-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
}