        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".container-fluid": {
              "padding-left": "0",
              "padding-right": "0",
              "overflow": "hidden"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".item": {
              "color": "@contentColor",
              "padding": "10px 0",
              "font-weight": "700"
            }
          },
          "_name": "features09",
          "_sourceTheme": "standm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features09 standm5\" group=\"Features\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        \n        <header>Animated Text Settings</header>\n        <select title=\"Font style\" name=\"linesTitle\">\n            <option value=\"title1\" selected>Title 1</option>\n            <option value=\"title2\">Title 2</option>\n        </select>\n        <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\" inline=\"\" name=\"animatedLine1\" value=\"Приемная президента • Екатериненский зал Кремля • Four Seasons Hotel • Hotel Savoy • The Ritz-Carlton • Дом дружбы народов • Константиновский дворец • Hovard Palace •\">\n        <input type=\"range\" inline title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.05\">\n        <select title=\"Direction\" name=\"direction\">\n            <option value=\"-1\" selected>Left</option>\n            <option value=\"1\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Content color\" value=\"#800020\" name=\"contentColor\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container-fluid\">\n\n        <div class=\"loop-container\">\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n            </div>\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_cid": "v3gsXCkcVv",
          "_anchor": "features09-6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "position": "sticky",
              "top": "40px",
              "@media (max-width: 992px)": {
                "position": "static",
                "margin-bottom": "40px"
              },
              ".mbr-label": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".card-wrapper": {
              "padding": "80px 60px 0",
              "position": "relative",
              "box-shadow": "0 10px 25px -20px @shadow",
              "overflow": "hidden",
              "@media (max-width: 992px)": {
                "padding": "80px 8px 0"
              },
              ".image-wrapper": {
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover"
                }
              },
              ".form-wrap": {
                "position": "relative",
                "z-index": "1",
                "background-color": "@cardBg",
                "padding": "24px 24px 40px",
                "border-bottom-left-radius": "0 !important",
                "border-bottom-right-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "20px 20px 40px"
                },
                ".dragArea.row": {
                  "position": "relative",
                  "z-index": "1",
                  "margin": "0 -9.6px",
                  ".form-group": {
                    "margin-bottom": "0 !important",
                    ".form-control-label": {
                      "margin-bottom": "10px"
                    },
                    ".form-control": {
                      "padding": "12px",
                      "background-color": "@inputBg",
                      "border": "1px solid @border !important",
                      "box-shadow": "none",
                      "margin-bottom": "20px",
                      "&::placeholder": {
                        "color": "@inputColor",
                        "opacity": ".7"
                      },
                      "&:hover, &:focus": {
                        "border": "1px solid @inputColor !important"
                      }
                    },
                    "textarea": {
                      "min-height": "145px"
                    },
                    ".form-check": {
                      "padding-left": "2.1em",
                      ".form-check-input": {
                        "background-color": "@inputColor",
                        "border-color": "@inputColor"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    "margin-top": "24px",
                    "@media (max-width: 992px)": {
                      "margin-top": "12px"
                    },
                    ".btn": {
                      "width": "100%",
                      "margin-bottom": "0",
                      "margin-right": "0",
                      "margin-top": "0"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#6c7179"
            },
            "label": {
              "color": "#6c7179"
            }
          },
          "_name": "form01",
          "_sourceTheme": "standm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 standm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#6c7179\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#f7f7f7\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#d1d3d6\" name=\"border\" selected>\n        <input type=\"color\" title=\"BG\" value=\"#ffffff\" name=\"cardBg\" selected>\n        <input type=\"color\" title=\"Shadow\" value=\"#6c7179\" name=\"shadow\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-5\">\n                            <div class=\"title-wrapper\">\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Связаться</h2>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Нужен полный каталог, прайс-листы фабрики и условия сотрудничества, 3D-модели конкретных изделий или образцы отделок для вашего проекта? <br><br>Будем рады ответить на ваши вопросы.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\">\n                            <div class=\"card-wrapper large-radius\">\n                                <div class=\"image-wrapper\">\n                                    <img class=\"large-radius\" src=\"@PROJECT_PATH@/assets/images/artigianalitacc80-886x674.webp\" alt=\"Francesco Molon Contact Form\">\n                                </div>\n                                <div mbr-form class=\"mbr-form form-wrap card-wrap little-radius\">\n<!--Formbuilder Form-->\n<form action=\"hello@nerokhova.ru\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"hello@nerokhova.ru\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Спасибо! Мы свяжемся с Вами в ближайшее время</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"Имя\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Имя\" class=\"form-control-label mbr-fonts-style\">Имя</label>\n<input type=\"text\" name=\"Имя\" placeholder=\"Александр Иванов\" data-form-field=\"Имя\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"email1\" class=\"form-control-label mbr-fonts-style\">Электронная почта</label>\n<input type=\"email\" name=\"email1\" placeholder=\"abivanov@yandex.ru\" data-form-field=\"email1\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div data-for=\"Телефон\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Телефон\" class=\"form-control-label mbr-fonts-style\">Телефон</label>\n<input type=\"text\" name=\"Телефон\" placeholder=\"+7-(900)-000-0000\" data-form-field=\"Телефон\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div data-for=\"Текст\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Текст\" class=\"form-control-label mbr-fonts-style\">Текст</label>\n<textarea name=\"Текст\" placeholder=\"Ваше сообщение\" data-form-field=\"Текст\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 btn btn-black\">Отправить</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vb8LGScZER",
          "_anchor": "form01-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features5",
          "_sourceTheme": "impressm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".content": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "20.4px"
            },
            ".animation-box": {
              "position": "relative",
              "width": "78px",
              "height": "86px"
            },
            "@keyframes zoom-1": {
              "0%, 10%": {
                "transform": "scale(0) rotate(0)"
              },
              "30%, 32%": {
                "transform": "scale(0.6) rotate(10deg)"
              },
              "100%, 85%": {
                "transform": "scale(0) rotate(60deg)"
              }
            },
            "@keyframes zoom-2": {
              "0%, 15%": {
                "transform": "scale(0) rotate(0)"
              },
              "50%, 54%": {
                "transform": "scale(0.4) rotate(0)"
              },
              "100%, 82%": {
                "transform": "scale(0) rotate(80deg)"
              }
            },
            ".star": {
              "color": "@animationColor",
              "fill": "currentColor",
              "overflow": "hidden"
            },
            ".star:nth-of-type(2)": {
              "position": "absolute",
              "top": "-35px",
              "left": "50px",
              "transform": "scale(0)",
              "& when (@animation)": {
                "animation": "zoom-1 3.1s infinite"
              }
            },
            ".star:nth-of-type(3)": {
              "position": "absolute",
              "top": "-45px",
              "left": "-50px",
              "& when (@animation)": {
                "animation": "zoom-2 3.1s infinite"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Width\" name=\"textWidth\" min=\"4\" max=\"12\" step=\"1\" value=\"9\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n        <header>Animation</header>\n        <input type=\"checkbox\" title=\"Show\" name=\"animation\">\n        <input type=\"color\" title=\"Color\" name=\"animationColor\" value=\"#ee3102\" condition=\"animation\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'con