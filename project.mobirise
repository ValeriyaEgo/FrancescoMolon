          "_name": "features02",
          "_sourceTheme": "standm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 standm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#f7f7f7\" name=\"containerBg\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Border\" value=\"#d1d3d6\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\"><b>\n                            ИЗ ПОКОЛЕНИЯ В ПОКОЛЕНИЕ</b></p>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Успех не бывает случайным: с 1966 года бренд Франческо Молон остаётся верен семейным традициям, объединяя безупречное мастерство и вневременной дизайн</h2>\n                    </div>\n                    <div class=\"card-wrapper large-radius\">\n                        <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                            <img src=\"@PROJECT_PATH@/assets/images/250409-molon-salone-25-0146-1-2104x1443.webp\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"items-wrapper\">\n                            <div class=\"row items-wrap justify-content-center\">\n                                <div class=\"col-12 col-lg-4 item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                            60</p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">лет семейных традиций и инноваций</h4>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-lg-4 item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                            3</p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                            уникальные коллекции от классики до модерна</h4>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-lg-4 item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                            32</p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">мастера высочайшего уровня</h4>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v3gsU5XQsw",
          "_anchor": "features02-2",
